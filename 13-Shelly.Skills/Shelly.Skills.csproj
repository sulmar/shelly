<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skille są zwykłymi plikami. Kopiujemy je obok aplikacji, aby agent mógł je odczytać. -->
    <None Include="skills/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
